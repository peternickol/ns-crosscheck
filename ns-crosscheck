    )


def walk(report, color):
    rows = [row for row in report.names if row.status not in ('match', 'unchecked') and row.types]
    if not rows:
        print('Every compared name matches.')
        return
    if not sys.stdin.isatty():
        for row in rows:
            sys.stdout.write(_name_text(report, row, color) + '\n')
        return
    index = 0
    while True:
        sys.stdout.write(_name_text(report, row := rows[index], color))
        print(f'{index + 1} of {len(rows)}. Enter for the next name, p for the previous, q to stop.')
        try:
            answer = input('> ').strip().lower()
        except EOFError:
            print()
            return
        if answer == 'q':
            return
        index = (index - 1 if answer == 'p' else index + 1) % len(rows)


def _name_text(report, row, color):
    lines = [paint(row.name, '1;36', color)]
    for item in row.types:
        if item.status == 'match':
            continue
        lines.append(f'  {item.rtype}')
        if item.old or item.status in ('only-old', 'differ', 'note', 'unchecked'):
            lines.append('    ' + _value('old', _ttl(item.old, item.old_ttl), '31', color))
        if not report.solo and (item.new or item.status in ('only-new', 'differ', 'note')):
            lines.append('    ' + _value('new', _ttl(item.new, item.new_ttl), '32', color))
    if report.old_at:
        rtype = next((item.rtype for item in row.types if item.status != 'match'), 'A')
        lines.append(f'  dig @{report.old_at} {row.name} {rtype} +norecurse')
    if report.new_at and report.new_at != report.old_at:
        rtype = next((item.rtype for item in row.types if item.status != 'match'), 'A')
        lines.append(f'  dig @{report.new_at} {row.name} {rtype} +norecurse')
    lines.append('')
    return '\n'.join(lines)


def _ttl(values, ttl):
    if ttl is None:
        return values
    return tuple(f'{value}  TTL {ttl}' for value in values)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog='ns-crosscheck',
        description='Compare a DNS zone on the nameservers you are moving from and to, using dig.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=EXAMPLES,
    )
    parser.add_argument('domain', nargs='?', help='Zone to compare, such as example.com')
    parser.add_argument('--old', action='append', default=[], metavar='HOST', help='Nameserver being moved away from')
    parser.add_argument('--new', action='append', default=[], metavar='HOST', help='Nameserver being moved to')
    parser.add_argument('--old-zone', metavar='FILE', help='Zone file for the old side, read with named-compilezone')
    parser.add_argument('--new-zone', metavar='FILE', help='Zone file for the new side, read with named-compilezone')
    parser.add_argument('--names', metavar='FILE', help='Extra names to query, one per line')
    parser.add_argument('--types', help='Comma-separated types to query when a transfer is refused')
    parser.add_argument('--timeout', type=float, default=3, help='Seconds to wait for dig (default: 3)')
    parser.add_argument('--port', type=int, default=53, help='DNS port (default: 53)')
    parser.add_argument('--no-axfr', action='store_true', help='Query names instead of asking dig for a zone transfer')
    parser.add_argument('--no-delegation', action='store_true', help='Skip dig +trace')
    parser.add_argument('--no-resolvers', action='store_true', help='Skip 1.1.1.1, 8.8.8.8, and 9.9.9.9')
    parser.add_argument('--strict-ttl', action='store_true', help='Treat a TTL difference as a flaw')
    parser.add_argument('--json', action='store_true', help='Print the report as JSON')
    parser.add_argument('--review', action='store_true', help='Walk names that are not a clean match')
    parser.add_argument('--demo', action='store_true', help='Show the built-in example, without running dig')
    parser.add_argument('--plain', action='store_true', help='Turn color off')
    parser.add_argument('--color', action='store_true', help='Turn color on')
    parser.add_argument('--version', action='store_true', help='Print the version and exit')
    parser.add_argument('--update', action='store_true', help='Update an installed copy from the GitHub repository')
    args = parser.parse_args(argv)
    if sys.version_info < MIN_PYTHON:
        parser.error('Python 3.10 or newer is required.')
    if args.version:
        print(f'ns-crosscheck {VERSION}')
        return 0
    if args.update:
        updater = Path(__file__).resolve().with_name('ns-crosscheck-update')
        if not updater.is_file():
            parser.error('This copy has no installed updater. Run the installer, or update your source checkout with Git.')
        raise SystemExit(subprocess.call([sys.executable, str(updater)]))
    try:
        report = _report(parser, args)
    except Fail as error:
        print(f'ns-crosscheck: {error}', file=sys.stderr)
        return 2
    color = _color(args)
    if args.json:
        print(json.dumps(to_json(report), indent=2))
    else:
        sys.stdout.write(render(report, color))
        if args.review:
            walk(report, color)
    return 0 if report.ok else 1


def _report(parser, args):
    if args.demo:
        if args.domain or args.old or args.new or args.old_zone or args.new_zone:
            parser.error('--demo uses the built-in example and takes no zone of its own.')
        return demo_report()
    if not args.domain:
        parser.error('Pass a domain, or --demo.')
    if args.old and args.old_zone:
        parser.error('Pass --old or --old-zone for the old side.')
    if args.new and args.new_zone:
        parser.error('Pass --new or --new-zone for the new side.')
    if args.timeout <= 0:
        parser.error('--timeout must be greater than zero.')
    if not args.old and not args.old_zone and args.no_delegation:
        parser.error('Pass --old or --old-zone, or allow the delegation lookup.')
    types = None
    if args.types:
        types = tuple(part.strip().upper() for part in args.types.split(',') if part.strip())
        if not types:
            parser.error('--types needs at least one type.')
    return check(Config(
        domain=args.domain,
        old_hosts=tuple(args.old),
        new_hosts=tuple(args.new),
        old_zone=args.old_zone,
        new_zone=args.new_zone,
        names=_names_file(args.names, args.domain) if args.names else (),
        types=types,
        axfr=not args.no_axfr,
        delegation=not args.no_delegation,
        resolvers=not args.no_resolvers,
        strict_ttl=args.strict_ttl,
        timeout=args.timeout,
        port=args.port,
    ))


def _names_file(path, domain):
    file = Path(path)
    if not file.is_file():
        raise Fail(f'{path} is not a file.')
    names = []
    for line in file.read_text(encoding='utf-8').splitlines():
        text = line.split('#', 1)[0].strip()
        if text:
            names.append(normalize_name(text if '.' in text else f'{text}.{domain}'))
    return tuple(names)


def _color(args):
    if args.plain or args.json:
        return False
    if args.color:
        return True
    if os.environ.get('NO_COLOR'):
        return False
    return sys.stdout.isatty()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except BrokenPipeError:
        raise SystemExit(0)
